# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Local dev: `docker compose up -d` starts a matching Postgres on localhost:5432.
# Production: use your hosting provider's connection string (Neon, Vercel Postgres, Supabase, Railway, ...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apu"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Optional: set to enable real AI chat-topic summarization via the Anthropic API.
# Without it, summaries fall back to a simple keyword/frequency heuristic.
ANTHROPIC_API_KEY=""
